# Initialize STHAN_SR_Predictor model
model = sthan_sr_model.STHAN_SR_Predictor(
    input_feature_dim=fea_num,
    num_stocks=stock_num, 
    gru_hidden_dim=gru_hidden_dim,
    gru_num_layers=gru_num_layers,
