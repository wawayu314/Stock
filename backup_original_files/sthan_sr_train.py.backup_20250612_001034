    spatial_attention_dropout_rate=spatial_attention_dropout_rate,
    output_dim=1,
    use_tanh_output=sthan_use_tanh_output
).to(device)

optimizer = torch.optim.Adam(model.parameters(), lr=learning_rate)
best_valid_loss = float('inf')
best_valid_perf_str = "None"
best_test_perf_str = "None"
best_valid_perf = None
best_test_perf = None
best_epoch_num = -1

batch_offsets = np.arange(start=0, stop=valid_index - lookback_length - steps + 1, dtype=int)
if len(batch_offsets) == 0:
    print(f"Error: Not enough data for training. Check valid_index ({valid_index}), lookback_length ({lookback_length}), steps ({steps}).")
    sys.exit()

def get_batch(offset):
    seq_len = lookback_length
    eod_batch = eod_data[:, offset:offset + seq_len, :]
    mask_raw = mask_data[:, offset: offset + seq_len + steps]
    current_mask_batch = np.min(mask_raw, axis=1)
    current_price_batch = price_data[:, offset + seq_len - 1]
    current_gt_batch = gt_data[:, offset + seq_len + steps - 1]
    return (
        eod_batch,
        np.expand_dims(current_mask_batch, axis=1),
        np.expand_dims(current_price_batch, axis=1),
        np.expand_dims(current_gt_batch, axis=1)
    )

def format_perf_metrics(perf):
    ic, ric, prec10, sr = float('nan'), float('nan'), float('nan'), float('nan')
    if isinstance(perf, dict):
        try:
            ic = float(perf.get('IC', float('nan')))
            ric = float(perf.get('RIC', float('nan')))
            prec10 = float(perf.get('prec_10', float('nan')))
            sr = float(perf.get('sharpe5', float('nan'))) # 使用 sharpe5 作为 SR
        except (ValueError, TypeError) as e:
            print(f"警告：无法从字典 {perf} 解析性能指标。错误：{e}")
            # ic, ric, prec10, sr 会因 .get 的默认值或初始值而保持为 NaN
            pass
    else:
        # 如果 perf 不是字典 (例如之前的尝试中它可能是其他类型)
        # 或者在某些未预料的错误情况下，evaluate返回了非字典类型
        print(f"警告：评估结果 perf 不是预期的字典类型，而是 {type(perf)}。指标将为 NaN。Perf 内容: {perf}")
        pass # 指标保持为 NaN
            
    return f"IC: {ic:.4f}, RIC: {ric:.4f}, Prec@10: {prec10:.4f}, SR: {sr:.4f}"

def validate(start_eval_index, end_eval_index, phase_name="Valid"):
    model.eval()
    with torch.no_grad():
        num_eval_days = end_eval_index - start_eval_index
        cur_pred = np.zeros([stock_num, num_eval_days], dtype=float)
        cur_gt = np.zeros([stock_num, num_eval_days], dtype=float)
        cur_mask = np.zeros([stock_num, num_eval_days], dtype=float)
        total_loss, total_reg_loss, total_rank_loss = 0., 0., 0.
        
        eval_offsets = np.arange(start_eval_index - lookback_length - steps + 1, 
                                 end_eval_index - lookback_length - steps + 1, dtype=int)
        if len(eval_offsets) == 0:
            print(f"Warning: Not enough data for {phase_name} evaluation at index {start_eval_index}-{end_eval_index} (0 days). Skipping.")
            return 0,0,0,None

        for day_idx, current_offset in enumerate(eval_offsets):
            data_b, mask_b, price_b, gt_b = map(
                lambda x: torch.from_numpy(x).float().to(device),
                get_batch(current_offset)
            )
            prediction_output = model(data_b)
            loss_val, reg_loss_val, rank_loss_val, rr_val = get_loss(
                prediction_output, gt_b, price_b, mask_b, stock_num, alpha
            )
            total_loss += loss_val.item()
            total_reg_loss += reg_loss_val.item()
            total_rank_loss += rank_loss_val.item()
            cur_pred[:, day_idx] = rr_val[:, 0].cpu().numpy()
            cur_gt[:, day_idx] = gt_b[:, 0].cpu().numpy()
            cur_mask[:, day_idx] = mask_b[:, 0].cpu().numpy()

        avg_loss = total_loss / len(eval_offsets)
        avg_reg_loss = total_reg_loss / len(eval_offsets)
        avg_rank_loss = total_rank_loss / len(eval_offsets)
        
        perf = evaluate(cur_pred, cur_gt, cur_mask)
    model.train()
    return avg_loss, avg_reg_loss, avg_rank_loss, perf

print("Starting STHAN-SR training...")
for epoch in range(epochs):
    print(f"Epoch {epoch + 1}/{epochs} ##########################################################")
    np.random.shuffle(batch_offsets)
    tra_loss, tra_reg_loss, tra_rank_loss = 0., 0., 0.
    optimizer.zero_grad()
    num_train_batches = len(batch_offsets)

    for batch_idx, current_offset in enumerate(batch_offsets):
        data_b, mask_b, price_b, gt_b = map(
            lambda x: torch.from_numpy(x).float().to(device),
            get_batch(current_offset)
        )
        model.train()
        prediction_output = model(data_b)
        cur_loss, cur_reg_loss, cur_rank_loss, _ = get_loss(
            prediction_output, gt_b, price_b, mask_b, stock_num, alpha
        )
        loss_to_backward = cur_loss / accumulation_steps
        loss_to_backward.backward()
        if (batch_idx + 1) % accumulation_steps == 0 or (batch_idx + 1) == num_train_batches:
            optimizer.step()
            optimizer.zero_grad()
        tra_loss += cur_loss.item()
        tra_reg_loss += cur_reg_loss.item()
        tra_rank_loss += cur_rank_loss.item()
        
    tra_loss /= num_train_batches
    tra_reg_loss /= num_train_batches
    tra_rank_loss /= num_train_batches
    print(f'Train: loss:{tra_loss:.4e} = {tra_reg_loss:.4e} + alpha*{tra_rank_loss:.4e}')

    val_loss, val_reg_loss, val_rank_loss, val_perf = validate(valid_index, test_index, phase_name="Valid")
    if val_perf is not None:
        current_val_perf_str = format_perf_metrics(val_perf)
        print(f'Valid: loss:{val_loss:.4e} = {val_reg_loss:.4e} + alpha*{val_rank_loss:.4e} | {current_val_perf_str}')
        if val_loss < best_valid_loss:
            best_valid_loss = val_loss
            best_epoch_num = epoch + 1
            best_valid_perf_str = current_val_perf_str
            best_valid_perf = val_perf
            
            # 获取测试集的损失值和性能指标
            test_loss_val, test_reg_loss_val, test_rank_loss_val, current_test_perf = validate(test_index, trade_dates, phase_name="Test")
            if current_test_perf is not None:
                best_test_perf_str = format_perf_metrics(current_test_perf)
                best_test_perf = current_test_perf
                print(f'Test (at best valid): loss:{test_loss_val:.4e} = {test_reg_loss_val:.4e} + alpha*{test_rank_loss_val:.4e} | {best_test_perf_str}')
            else:
                best_test_perf_str = "Test perf: N/A (evaluation failed or no data)"
                best_test_perf = None
                print(f'Test (at best valid): loss:{test_loss_val:.4e} | {best_test_perf_str}')
    else:
         print(f'Valid: loss:{val_loss:.4e} | Perf: N/A (evaluation failed or no data)')
    print() # 在每个epoch的主要输出后添加一个空行

print("\nSTHAN-SR Training Finished.")
print(f"Best Epoch: {best_epoch_num}")
print(f"Best Valid Loss: {best_valid_loss:.4e}")
print(f"Best Valid Performance: {best_valid_perf_str}")
print(f" Corresponding Test Performance: {best_test_perf_str}") 

